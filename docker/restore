#!/bin/sh
# Replaces everything on this server with a backup made by `backup`:
#   docker compose exec -T anchor-plus restore < anchor-backup.tar
# The backup can come from an earlier release; its database is brought up
# to this one's. Anchor restarts at the end, with the backup's sign-in
# secret, so the apps stay signed in.
set -eu
. /app/anchor-env.sh

DATA=/data
STAGE="$DATA/.anchor-restore"

if [ -t 0 ]; then
  echo "restore reads a backup .tar from stdin, with -T:" >&2
  echo "  docker compose exec -T anchor-plus restore < anchor-backup.tar" >&2
  exit 1
fi

rm -rf "$STAGE"
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE"

echo "[restore] Reading the backup..." >&2
tar -xf - -C "$STAGE"
MANIFEST="$STAGE/.anchor-backup/manifest.json"
DUMP="$STAGE/.anchor-backup/database.dump"
if [ ! -f "$MANIFEST" ] || [ ! -f "$DUMP" ]; then
  echo "[restore] ERROR: that isn't a backup from \`backup\`" >&2
  exit 1
fi
if ! grep -q '"format": 1,' "$MANIFEST"; then
  echo "[restore] ERROR: this release can't read that backup's format" >&2
  exit 1
fi
pg_restore --list "$DUMP" >/dev/null
sed -n 's/^ *"\(created\|server\)": *"\(.*\)".*/[restore] backup \1: \2/p' "$MANIFEST" >&2

echo "[restore] Stopping Anchor..." >&2
supervisorctl -c /etc/supervisord.conf stop web api >/dev/null

echo "[restore] Restoring the database..." >&2
PGOPTIONS='-c client_min_messages=warning' psql "$DATABASE_URL" -q -v ON_ERROR_STOP=1 \
  -c 'DROP SCHEMA public CASCADE' -c 'CREATE SCHEMA public' >&2
pg_restore --no-owner --no-privileges --exit-on-error --single-transaction \
  --dbname="$DATABASE_URL" "$DUMP"

echo "[restore] Restoring the files..." >&2
cd "$DATA"
for entry in .[!.]* ..?* *; do
  [ -e "$entry" ] || continue
  case "$entry" in
    postgres | backups | models | .anchor-restore) ;;
    *) rm -rf "$entry" ;;
  esac
done
rm -rf "$STAGE/.anchor-backup"
cd "$STAGE"
for entry in .[!.]* ..?* *; do
  [ -e "$entry" ] || continue
  rm -rf "$DATA/$entry"
  mv "$entry" "$DATA/"
done
cd "$DATA"

echo "[restore] Bringing the database up to this release..." >&2
(cd /app/server && ./node_modules/.bin/prisma migrate deploy) >&2

# Starts again from the entrypoint, which reads the restored sign-in secret.
echo "[restore] Done; Anchor restarts now. If it doesn't come back (no restart policy), run: docker compose up -d" >&2
if [ "$USE_EMBEDDED_POSTGRES" = "1" ]; then
  su postgres -c "pg_ctl -D '$PGDATA' stop -m fast" >/dev/null
fi
(sleep 1; kill -TERM 1) >/dev/null 2>&1 &

#!/bin/sh
# Sets a new password for any account:
#   docker exec -it anchor-plus reset-password                 list the accounts
#   docker exec -it anchor-plus reset-password <email>         generate a password
#   docker exec -it anchor-plus reset-password <email> --password   type one
set -eu
. /app/anchor-env.sh
cd /app/server
exec /usr/local/bin/node dist/src/cli/reset-password.js "$@"

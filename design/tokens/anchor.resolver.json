{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "name": "Anchor",
  "description": "Anchor's design tokens. Everything in base.tokens.json, then the chosen theme on top.",
  "sets": {
    "base": {
      "description": "Values that do not change with the theme",
      "sources": [
        {
          "$ref": "base.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "Light or dark. Both files have the same token names.",
      "contexts": {
        "light": [
          {
            "$ref": "light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "dark.tokens.json"
          }
        ]
      },
      "default": "light"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    }
  ]
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NoteState {
  active
  trashed
  deleted
}

enum UserStatus {
  active
  pending
}

enum NoteSharePermission {
  viewer
  editor
}

/// Shared with upstream Anchor: only its values, so its server can read every
/// row. Any other kind of file is a NoteFile.
enum AttachmentType {
  image
  audio
}

enum SyncEntityType {
  note
  tag
  pin
  attachments
  reminder
}

enum ReminderRecurrence {
  none
  daily
  weekly
  monthly
  yearly
}

enum SyncOp {
  upsert
  remove
}

enum RevisionCause {
  edit
  conflict
  restore
}

model User {
  id                   String           @id @default(uuid())
  email                String           @unique
  password             String?
  name                 String
  profileImage         String?
  apiToken             String?          @unique
  isAdmin              Boolean          @default(false)
  status               UserStatus       @default(active)
  oidcSubject          String?          @unique
  /// Opted in to finding notes by what their pictures show.
  pictureSearch        Boolean          @default(false)
  /// The PIN and the pattern that open notes locked with them, hashed
  /// ("pbkdf2-sha256$iterations$salt$hash"); one of each for all notes.
  lockPin              String?
  lockPattern          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  notes                Note[]
  tags                 Tag[]
  sharedNotes          NoteShare[]      @relation("SharedBy")
  notesSharedWithMe    NoteShare[]      @relation("SharedWith")
  refreshTokens        RefreshToken[]
  uploadedAttachments  NoteAttachment[]
  uploadedFiles        NoteFile[]
  notePins             NotePin[]
  noteArchives         NoteArchive[]
  noteOrders           NoteOrder[]
  noteLocks            NoteLock[]
  noteInvisibles       NoteInvisible[]
  syncState            SyncState?
  changeLog            ChangeLog[]
  noteRevisions        NoteRevision[]
  noteReminders        NoteReminder[]
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id          String      @id @default(uuid())
  title       String
  content     String?
  background  String?
  state       NoteState   @default(active)
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  stateChangedAt DateTime @default(now())
  // Frozen by its owner: nobody can change, trash or delete it until it's
  // unfrozen.
  isFrozen    Boolean     @default(false)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        Tag[]
  sharedWith  NoteShare[]
  shareLink   NoteShareLink?
  attachments NoteAttachment[]
  files       NoteFile[]
  pins        NotePin[]
  archives    NoteArchive[]
  orders      NoteOrder[]
  locks       NoteLock[]
  invisibles  NoteInvisible[]
  reminders   NoteReminder[]
  revisions   NoteRevision[]

  @@index([userId])
  @@index([state, stateChangedAt])
}

// A reminder belongs to the person, not the note: sharees each get their own.
model NoteReminder {
  userId     String
  noteId     String
  remindAt   String // local wall clock, "YYYY-MM-DDTHH:mm"
  recurrence ReminderRecurrence @default(none)
  version    Int                @default(1)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  note       Note               @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
}

// Where a person dragged a note among their notes; until they edit it
// again, it sorts there instead of by when it was last edited.
model NoteOrder {
  userId    String
  noteId    String
  position  Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
}

enum NoteLockKind {
  tap
  pin
  pattern
  biometric
}

// A note this person locked, and what opens it. Like pins, each person's
// own; the note itself is unchanged (not encrypted), so exports show it.
model NoteLock {
  userId    String
  noteId    String
  kind      NoteLockKind
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
}

// A note this person made invisible: it stays out of their lists and only
// turns up when they search. Like pins, each person's own.
model NoteInvisible {
  userId    String
  noteId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
}

model NotePin {
  userId    String
  noteId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
}

model NoteArchive {
  userId    String
  noteId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  color     String?
  /// Where the person dragged it among their tags; unplaced tags come
  /// after the placed ones, by name.
  position  Float?
  isDeleted Boolean   @default(false)
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]

  // (userId, name) uniqueness is enforced for active tags via a partial index in migration
}

model NoteShare {
  id              String         @id @default(uuid())
  noteId          String
  note            Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  sharedWithUserId String
  sharedWithUser  User           @relation("SharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  permission      NoteSharePermission
  sharedByUserId  String
  sharedByUser    User           @relation("SharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  isDeleted       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([noteId, sharedWithUserId])
  @@index([noteId])
  @@index([sharedWithUserId])
}

// A link that opens the note without an account, to read it or to change
// its text; one per note, made by its owner. Taking it away deletes it, so a
// new one has a new token.
model NoteShareLink {
  noteId     String              @id
  token      String              @unique
  permission NoteSharePermission
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  note       Note                @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model SyncState {
  userId           String @id
  lastSeq          BigInt @default(0)
  prunedThroughSeq BigInt @default(0)
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // lastSeq is only advanced by next_sync_seq(uid, n).
}

model ChangeLog {
  recipientUserId String
  entityType      SyncEntityType
  entityId        String
  op              SyncOp
  seq             BigInt
  updatedAt       DateTime       @updatedAt
  recipient       User           @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  // One row per (recipient, entity), re-stamped with a fresh seq on each
  // change. No FK on entityId: rows outlive the entities they point at.
  @@id([recipientUserId, entityType, entityId])
  @@unique([recipientUserId, seq])
  @@index([op, updatedAt])
}

model NoteRevision {
  id           String        @id @default(uuid())
  noteId       String
  version      Int
  title        String
  content      String?
  authorUserId String?
  cause        RevisionCause
  createdAt    DateTime      @default(now())
  note         Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author       User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([noteId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model NoteAttachment {
  id               String         @id @default(uuid())
  noteId           String
  uploadedByUserId String
  type             AttachmentType
  originalFilename String
  storedFilename   String
  mimeType         String
  fileSize         Int
  position         Int            @default(0)
  /// The text read from a picture, for search; null until it's been read.
  text             String?
  /// When the picture was read (with or without finding text).
  textReadAt       DateTime?
  embedding        PictureEmbedding?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  note             Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  uploadedByUser   User           @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([uploadedByUserId])
  @@index([type, textReadAt])
}

/// Any other kind of file attached to a note (documents, archives, a zipped
/// folder): an attachment of type "file" to the apps, placed among the note's
/// pictures and recordings by position. It has a table of its own, rather
/// than an AttachmentType value, so upstream Anchor's server can run on this
/// database: it doesn't read this table, and the files come back on
/// switching back to Anchor+.
model NoteFile {
  id               String   @id @default(uuid())
  noteId           String
  uploadedByUserId String
  originalFilename String
  storedFilename   String
  mimeType         String
  fileSize         Int
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  note             Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([uploadedByUserId])
}

/// What a picture shows, as a vector from the picture search model, to find
/// pictures by a description.
model PictureEmbedding {
  attachmentId String         @id
  attachment   NoteAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  /// The model that made it; another model's vectors don't compare.
  model        String
  /// Float32 values, normalized to length 1.
  vector       Bytes
  createdAt    DateTime       @default(now())
}

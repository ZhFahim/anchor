# Copy this file to .env and adjust values as needed.

APP_URL=http://localhost:3000  # Application URL for OIDC callback and redirects

# JWT signing secret. Must be at least 16 characters.
JWT_SECRET=<random-secret>

PG_HOST=localhost # leave empty to use embedded Postgres
PG_USER=anchor
PG_PASSWORD=password
PG_DATABASE=anchor
PG_PORT=5432

# Optional: override the root directory for persisted uploads (defaults to /data).
# DATA_DIR=/data

# Optional: comma-separated allowlist of CORS origins. Leave unset to allow all.
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# Optional: Set to 'disabled', 'enabled', or 'review' to lock sign up mode.
# If not set, admins can control it via the admin panel.
# USER_SIGNUP=enabled

### OIDC Authentication (optional)
# OIDC_ENABLED=false
# OIDC_PROVIDER_NAME="Pocket ID"
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret  # Optional: omit for public client (PKCE)
# DISABLE_INTERNAL_AUTH=false  # Turn off email and password sign-in when OIDC is enabled